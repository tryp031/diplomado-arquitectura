# Copia este archivo a .env.aws (misma carpeta) para que el panel y verificar-aws.sh lean AWS.
# Es el mismo esquema del Reto 2, con su propio archivo: no se mezcla con ~/.aws ni con el Reto 2.
# NUNCA subas .env.aws: está en .gitignore. No uses `git add -f`.
# Después: scripts/panel.sh  (switch AWS)  ·  scripts/verificar-aws.sh

# --- Usuario IAM de SOLO LECTURA del Reto 3 (reto3-panel-lectura, cuenta del equipo) ---
# Nunca las de un usuario administrador ni las de otra cuenta de AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
