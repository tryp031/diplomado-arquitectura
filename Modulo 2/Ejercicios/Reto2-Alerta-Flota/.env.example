# Copia este archivo a .env  (NUNCA subas .env: el repo es público)

# --- Desarrollo: Mailpit (requiere `docker compose --profile dev up`) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=alertas@reto2.local
MAIL_TO=danny@reto2.local

# --- Gmail (demo y mediciones): descomenta y reemplaza lo de arriba ---
# Requiere verificación en 2 pasos + App Password (16 letras, sin espacios)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=tu.cuenta@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM=tu.cuenta@gmail.com
# MAIL_TO=tu.cuenta@gmail.com

# Timeout por operación SMTP (s). Corto para que una conexión colgada se reintente rápido.
# SMTP_TIMEOUT_S=4

# Envíos de correo simultáneos del notifier
NOTIFIER_CONCURRENCY=5
