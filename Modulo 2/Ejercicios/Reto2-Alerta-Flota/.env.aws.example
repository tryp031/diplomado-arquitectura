# Copia este archivo a .env.aws para que el switch del panel pueda observar la opción B en AWS.
# NUNCA subas .env.aws: lleva credenciales y la URL de un endpoint que acepta POST sin autenticación.
# Después: docker compose --profile dev --profile panel up -d --build panel

# --- Lo que se dispara (k6 y el Emergency manual) ---
AWS_API_URL=https://<id-api>.execute-api.us-east-2.amazonaws.com/prod/event-notification

# --- Lo que se lee ---
AWS_REGION=us-east-2
AWS_LOG_GROUP_INGESTA=/aws/lambda/reto2-ingesta
AWS_LOG_GROUP_NOTIFIER=/aws/lambda/reto2-notifier
AWS_SQS_URL=https://sqs.us-east-2.amazonaws.com/<cuenta>/reto2-emergencias
AWS_SQS_DLQ_URL=https://sqs.us-east-2.amazonaws.com/<cuenta>/reto2-emergencias-dlq

# --- Credenciales de un usuario IAM de SOLO LECTURA (política en docs/2026-10-12-panel-switch-aws.md) ---
# Nunca las de un usuario administrador ni las de otra cuenta de AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
