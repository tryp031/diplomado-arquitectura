# Token bucket global, como un stage de API Gateway: rate = recarga, burst = tamaño del cubo.
# Clave constante = UN cubo para todo el tráfico. No usar $server_name: aquí está vacío y nginx
# NO cuenta las peticiones con clave vacía (el límite quedaría configurado pero sin aplicar).
map $request_method $limit_key { default "gateway"; }
limit_req_zone $limit_key zone=api:1m rate=15r/s;
limit_req_status 429;

log_format reto2 escape=json '{"msec":$msec,"status":$status,"request_time":$request_time,"method":"$request_method","uri":"$request_uri"}';

# DNS interno de Docker, re-consultado cada 5 s: si una réplica de ingest se recrea con otra IP
# (p. ej. tras `docker compose up --build`), nginx la sigue en vez de responder 502.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream ingest {
    zone ingest 64k;
    server ingest:8000 resolve;   # todas las réplicas; requiere nginx >= 1.27.3
    keepalive 32;
}

server {
    listen 80;
    access_log /var/log/nginx/gateway-access.log reto2;

    location /events {
        limit_req zone=api burst=${RATE_BURST} nodelay;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ingest;
    }

    location /health {
        proxy_pass http://ingest;
    }
}
